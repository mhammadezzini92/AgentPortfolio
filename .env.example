# Copy to .env.local. Never commit real values.

# Turso / libSQL. For local dev you can use file:local.db and leave the token empty.
TURSO_DATABASE_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=

# Vercel Blob (server-only)
BLOB_READ_WRITE_TOKEN=

# OpenRouter (server-only). Model ids are "vendor/model"; the model must support structured outputs.
OPENROUTER_API_KEY=
OPENROUTER_EXTRACTION_MODEL=openai/gpt-4o-mini
OPENROUTER_ANSWER_MODEL=openai/gpt-4o-mini
EXTRACTION_MAX_OUTPUT_TOKENS=4000

# Admin session. Generate AUTH_SECRET with: openssl rand -base64 48
ADMIN_PASSWORD=
AUTH_SECRET=

# Public chat limits
CHAT_MAX_INPUT_CHARS=1000
CHAT_MAX_OUTPUT_TOKENS=600
RETRIEVAL_TOP_K=8
